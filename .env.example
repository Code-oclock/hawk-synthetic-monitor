# Hawk (required). Inside Docker, reach a Hawk on the same machine via host.docker.internal.
HAWK_COLLECTOR_URL=http://host.docker.internal:3000/
HAWK_API_URL=http://host.docker.internal:4000/graphql
HAWK_PROJECT_ID=
HAWK_INTEGRATION_TOKEN=
HAWK_EMAIL=
HAWK_PASSWORD=

# Telegram alerts through @codex_bot (send /notify_start in your chat to get the URL). Optional.
TELEGRAM_NOTIFY_URL=

# Heartbeat: the monitor pings this URL after every finished check; the watchdog
# (docker compose --profile watchdog up -d) alerts Telegram when the pings stop.
# Run the watchdog on another machine to also catch the death of the monitor's host.
# HEARTBEAT_URL=http://watchdog:8090/ping

# Optional tuning (defaults shown).
# MONITOR_INTERVAL=10m
# MONITOR_RUN_TIMEOUT=90s
# MONITOR_VISIBLE_TIMEOUT=30s
# MONITOR_WEBHOOK_TIMEOUT=30s
# MONITOR_POLL_INTERVAL=500ms
# MONITOR_MAX_ATTEMPTS=3
# MONITOR_HTTP_ADDR=:8080
# MONITOR_WEBHOOK_ADDR=:8085
# MONITOR_DB_PATH=monitor.db
